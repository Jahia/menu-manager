<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.0.0</version>
    </parent>
    <groupId>org.jahia.community</groupId>
    <artifactId>menu-manager-root</artifactId>
    <name>Menu Manager (root)</name>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>Menus built by hand, independent of the page tree: a jContent screen to create menus of pages, sections, internal and external links, ordered by drag and drop and translated with a fallback language, and a component that places a menu on a page.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:Jahia/menu-manager.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/menu-manager.git</developerConnection>
        <url>https://github.com/Jahia/menu-manager</url>
        <tag>HEAD</tag>
    </scm>

    <!-- The Java bundle (content types, resolver, GraphQL, the jContent Menus screen), then the
         JavaScript module with the views of the menu component, which depends on it. -->
    <modules>
        <module>menu-manager</module>
        <module>menu-manager-views</module>
    </modules>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>jahia-releases-archives</id>
            <name>Jahia Releases Archive</name>
            <url>https://archives-devtools.jahia.com/jahia-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>jahia-thirdparty-archives</id>
            <name>Jahia Third-Party Releases Archive</name>
            <url>https://archives-devtools.jahia.com/thirdparty-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>jahia-releases-archives</id>
            <name>Jahia Releases Archive</name>
            <url>https://archives-devtools.jahia.com/jahia-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>jahia-thirdparty-archives</id>
            <name>Jahia Third-Party Releases Archive</name>
            <url>https://archives-devtools.jahia.com/thirdparty-releases</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!-- The release writes the Maven version into each module's package.json (.m2/sync-version.mjs) and
         commits it before the poms (.m2/commit-synced-files.sh): Maven's release bumps the poms only,
         and the views package would otherwise ship as 1.0.0-SNAPSHOT. After Formidable's setup. -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <preparationGoals>-P release-prepare clean verify exec:exec@commit-synced-files</preparationGoals>
                    <completionGoals>-P release-prepare clean install exec:exec@commit-synced-files</completionGoals>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-prepare</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <!-- Before the front-end builds of the module: they pack package.json -->
                            <execution>
                                <id>sync-version</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/.m2/sync-version.mjs</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Not bound to a phase: the release plugin calls it after the build -->
                            <execution>
                                <id>commit-synced-files</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/.m2/commit-synced-files.sh</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
