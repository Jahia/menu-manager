{
  "name": "menu-manager-views",
  "version": "1.0.0-SNAPSHOT",
  "description": "Views of the Menu Manager component (mnu:navigation), one per layout: a horizontal bar with dropdowns (default), a mega menu, a vertical list, columns",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && run package",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "format": "prettier --write --list-different .",
    "lint": "eslint .",
    "package": "yarn pack --out dist/package.tgz",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.26.0",
    "@jahia/javascript-modules-library": "^1.3.1",
    "@jahia/vite-plugin": "^1.3.1",
    "@types/react": "^19.1.2",
    "eslint": "^9.26.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^16.0.0",
    "i18next": "^26.4.2",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-i18next": "^17.0.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^7.0.0",
    "vitest": "^3"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "jahia": {
    "name": "menu-manager-views",
    "snapshot": true,
    "required-version": "8.2.1.0",
    "module-type": "module",
    "module-dependencies": "default,menu-manager,javascript-modules-engine=[1.3,2)",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/locales,/images,/icons,/static",
    "maven": {
      "groupId": "org.jahia.community"
    }
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "5.3.0"
  },
  "license": "MIT"
}
