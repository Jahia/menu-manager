<?xml version="1.0" encoding="UTF-8"?>
<!-- manageMenus: who may use jContent > Menus on a site. Under site-admin, so roles holding
     site-admin hold it, and an administrator can grant it alone to an editor role. -->
<permissions xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:jnt="http://www.jahia.org/jahia/nt/1.0">
    <site-admin jcr:primaryType="jnt:permission">
        <manageMenus jcr:primaryType="jnt:permission"/>
    </site-admin>
</permissions>
