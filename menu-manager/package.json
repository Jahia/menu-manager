    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.11.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "16.5.0",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.0",
